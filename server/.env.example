# DarkWear Server Environment Configuration Example

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Example local: mongodb://127.0.0.1:27017/darkwear
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/darkwear?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/darkwear

# Firebase Admin SDK Configuration
# You can obtain these from Firebase Console -> Project Settings -> Service accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# For FIREBASE_PRIVATE_KEY, keep the quotes and escape newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional path to serviceAccountKey.json if you prefer file-based admin credential:
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Admin Emails (comma separated list of emails that automatically receive admin privileges upon login/sync)
ADMIN_EMAILS=admin@darkwear.com,admin@example.com
